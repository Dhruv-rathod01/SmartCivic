<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 p-10 text-white" >
        <h1 class="text-3xl mb-5">Login Account</h1>
        <form action="/login" method="post">
    
            <input class="block mb-2 px-3 py-2 outline-none border-2 rounded bg-transparent border-zinc-800"type='text' placeholder="username" name="username">
           
            <input class="block mb-2 px-3 py-2 outline-none border-2 rounded bg-transparent border-zinc-800"type='email' placeholder="email" name="email">
            <input class="block mb-2 px-3 py-2 outline-none border-2 rounded bg-transparent border-zinc-800"type='password' placeholder="password" name="password">
            <input class="block mb-2 bg-blue-500  px-3 py-2 outline-none rounded-md text-sm hover:bg-blue-600"type = 'submit' value="Login Account">

            <% if (message) { %>
                <p class="text-red-500 mb-3"><%= message %></p>
            <% } %>
             <a href="/" class="inline-block px-5 py-2 mt-4 bg-blue-500 text-white rounded-md hover:bg-blue-600 transition">Register Account</a>
        </form>

    </div>
</body>
</html>