
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="w-full min-h-screen bg-zinc-900 p-10 text-white
                flex justify-center items-center">

        <div class="w-full max-w-sm bg-zinc-800 p-8 rounded-2xl
                    shadow-2xl border border-zinc-700">

            <h1 class="text-3xl font-bold text-center mb-2">
                Forgot Password?
            </h1>

            <p class="text-sm text-zinc-400 text-center mb-6">
                Enter your registered email to reset your password.
            </p>

            <form action="/forgot-password" method="post">

                <input
                    class="block w-full mb-4 px-3 py-3 outline-none
                           border rounded-lg bg-transparent
                           border-zinc-700 focus:border-blue-500"
                    type="email"
                    placeholder="Enter your email"
                    name="email"
                    required
                >

                <input
                    class="block w-full px-3 py-3 bg-blue-600
                           rounded-lg text-sm font-semibold
                           hover:bg-blue-500 cursor-pointer transition"
                    type="submit"
                    value="Send Reset Link"
                >

            </form>

            <% if (typeof message !== 'undefined' && message) { %>
                <p class="text-red-400 text-sm mt-4 text-center">
                    <%= message %>
                </p>
            <% } %>

            <p class="text-sm text-center text-zinc-400 mt-6">
                Remember your password?
                <a href="/login" class="text-blue-400 hover:text-blue-300">
                    Login
                </a>
            </p>

        </div>
    </div>
</body>
</html>
