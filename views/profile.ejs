<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>

   <div class="w-full min-h-screen bg-zinc-900 p-6  text-white">

        

<!-- Professional Navbar -->

<nav class="flex items-center justify-between px-6 py-4
            bg-zinc-900 border-b border-zinc-800">

    <!-- Brand -->

    <a  class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-blue-600
                    flex items-center justify-center
                    text-white font-bold text-xl">
            SC
        </div>

        <div>
            <h1 class="text-xl font-bold tracking-tight">
                Smart<span class="text-blue-500">Civic</span>
            </h1>
            <p class="text-xs text-zinc-500">
                Building better communities
            </p>
        </div>
    </a>

    <!-- Right Section -->
    <div class="flex items-center gap-4">

        <div class="hidden sm:block text-right">
            <p class="text-sm font-medium text-zinc-200">
                <%= user.name %>
            </p>
            <p class="text-xs text-zinc-500">
                Community Member
            </p>
        </div>

        <div class="h-9 w-px bg-zinc-700 hidden sm:block"></div>

        <a href="/logout"
           class="px-4 py-2 rounded-lg border border-zinc-700
                  text-sm font-medium text-zinc-300
                  hover:bg-red-500/10 hover:text-red-400
                  hover:border-red-500/30 transition">
            Logout
        </a>

    </div>
</nav>

</nav>

     
        <!-- Create Post -->
        <div class="mt-8 mb-10">
           <h2 class="text-xl font-semibold text-white flex items-center gap-2">
    <span class="text-blue-400">✦</span> Report a Civic Issue
</h2>
<p class="text-sm text-zinc-400 mt-1">
    Help make your community better by reporting an issue.
</p>

            <form action="/post" method="post" class="mt-3">

                
                    <textarea
                    name="content"
                    class="block w-full max-w-2xl h-36 p-4 outline-none resize-none bg-zinc-800 border border-zinc-700 rounded-xl text-white placeholder:text-zinc-500 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition"
                    placeholder="What's your problem? Describe the civic issue you noticed..."
                    ></textarea>


                <input
                   class="block px-6 py-3 bg-blue-600 rounded-lg mt-4 font-semibold text-white hover:bg-blue-500 active:scale-95 cursor-pointer transition duration-200 shadow-lg shadow-blue-600/20"
                    type="submit"
                    value="Submit Report">

            </form>
        </div>

        <!-- Your Posts -->
        <div class="mt-12">

            <h3 class="text-2xl font-bold mb-2">Your Activity</h3>
<p class="text-sm text-zinc-400 mb-6">Track the civic issues you've reported.</p>

            <% user.posts.reverse().forEach(function(post){%>
                    <div class="text-blue-400 hover:text-blue-300 transition">

               <div class="w-full p-5 rounded-xl border border-zinc-700/80 bg-zinc-800/80 mb-4 hover:border-zinc-600 transition duration-200">

                    <h4 class="text-blue-400 font-semibold text-sm mb-3">
                        @<%=user.username %>
                       
                    </h4>

                    <p class="text-zinc-300  tracking-tight " >
                         <%= post.content %> 
                    </p>
                    <small class=" mt-2 inline-block text-zinc-400 "><%= post.likes.length %>likes</small>
                    <div class=" flex mt-2 gap-4 mt-1  ">
                        <a class="text-red-500" href="/like/<%=post._id%>">♥ Like</a>
                        <a class="class=text-sm font-medium text-blue-400 hover:text-blue-300 transition">Edit</a>
                    </div>
                    

                </div>

            </div>
           <% }) %>
            

        </div>

    </div>

</body>

</html>