<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
     <div class="w-full min-h-screen bg-zinc-900 p-10 text-white flex flex-col justify-center items-center">
        <div class="w-full max-w-sm bg-zinc-800 p-8 rounded-2xl shadow-2xl border-2 border-zinc-700">
    <h1 class="text-3xl font-bold text-center mb-2">Login Account</h1>
        <form action="/login" method="post">
    
            <input class="block w-full mb-4 px-3 py-2 outline-none border-2 rounded-lg bg-transparent border-zinc-700"type='text' placeholder="username" name="username">
           
            <input class="block w-full mb-4 px-3 py-2 outline-none border-2 rounded-lg bg-transparent border-zinc-700"type='email' placeholder="email" name="email">
            <input class="block w-full mb-4 px-3 py-2 outline-none border-2 rounded-lg bg-transparent border-zinc-700"type='password' placeholder="password" name="password">
            <input class="block w-full mb-4 bg-blue-500 px-3 py-2 outline-none rounded-lg text-sm font-semibold hover:bg-blue-600 transition cursor-pointer"type = 'submit' value="Login Account">

            <% if (message) { %>
                <p class="text-red-500 mb-3"><%= message %></p>
            <% } %>
         
        </form>
       <div class="flex items-center gap-3 my-5">
    <div class="flex-1 border-t border-gray-300"></div>
    <span class="text-sm text-gray-500">OR CONTINUE WITH</span>
    <div class="flex-1 border-t border-gray-300"></div>
</div>

<a href="/auth/google"
   class="flex items-center justify-center gap-3 w-full py-3 px-4
          border border-gray-300 rounded-xl bg-white text-gray-700
          font-medium text-sm shadow-sm
          hover:bg-gray-50 hover:shadow-md
          transition-all duration-200">

    <svg xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 48 48"
         class="w-5 h-5">
        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 3.08 13.22l7.98 6.19C12.95 13.72 18.02 9.5 24 9.5z"/>
        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.72 7.18l7.62 5.91c4.45-4.11 7.14-10.17 7.14-17.56z"/>
        <path fill="#FBBC05" d="M10.06 28.59A14.4 14.4 0 0 1 9.3 24c0-1.59.27-3.13.76-4.59l-7.98-6.19A23.9 23.9 0 0 0 0 24c0 3.87.93 7.52 2.58 10.78l7.48-6.19z"/>
        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.9-5.89l-7.62-5.91c-2.12 1.42-4.83 2.26-8.28 2.26-5.98 0-11.05-4.22-12.94-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
    </svg>

    <span>Continue with Google</span>
</a>

    <div class="flex items-center justify-between gap-3 border-t border-zinc-800 pt-3 mt-2 mb-3 text-sm">

    <div class="text-zinc-400">
        Don't have an account?
        <a href="/register"
           class="text-blue-400 hover:text-blue-300 font-semibold transition">
            Register
        </a>
    </div>

    <a href="/forgot-password"
       class="text-red-400 hover:text-red-300  whitespace-nowrap">
        Forgot Password?
    </a>

</div>

    </div>
</body>
</html>