<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>

    <div class="w-full min-h-screen bg-zinc-900 p-10 text-white">

        <!-- Header -->
        <div class="flex items-center justify-between">
            <h1 class="text-2xl">
                <span class="font-light">Welcome to SmartCivic,</span>
                <%= user.name %> 🙏🏻
            </h1>

            <a href="/logout"
               class="text-red-500 hover:text-red-400 transition">
                Logout
            </a>
        </div>

        <!-- Create Post -->
        <div class="mt-2">
            <h5 class="font-light text-zinc-400">
                You can create a new post
            </h5>

            <form action="/post" method="post" class="mt-3">

                <textarea
                    name="content"
                    class="block p-3 outline-none resize-none bg-transparent border border-zinc-700 w-1/2 h-32 rounded-md focus:border-zinc-500"
                    placeholder="What civic issue did you notice?"></textarea>

                <input
                    class="block px-5 py-2 bg-blue-500 rounded-md mt-3 hover:bg-blue-600 cursor-pointer transition"
                    type="submit"
                    value="Create New Post">

            </form>
        </div>

        <!-- Your Posts -->
        <div class="mt-12">

            <h3 class="text-xl mb-4">
                Your Posts
            </h3>
            <% user.posts.reverse().forEach(function(post){%>
                    <div class="flex flex-wrap gap-4">

                <div class="w-1/3 min-w-80 p-2 rounded-md border-[1px] border-zinc-700 bg-zinc-800 mb-2">

                    <h4 class="text-blue-400 mb-2">
                        @<%=user.username %>
                       
                    </h4>

                    <p class="text-zinc-300  tracking-tight " >
                         <%= post.content %> 
                    </p>
                    <small class=" mt-2 inline-block text-zinc-400 "><%= post.likes.length %>likes</small>
                    <div class=" flex mt-2 gap-4 mt-1  ">
                        <a class="text-red-500" href="/like/<%=post._id%>">Like</a>
                        <a class="text-red-500">Edit</a>
                    </div>
                    

                </div>

            </div>
           <% }) %>
            

        </div>

    </div>

</body>

</html>